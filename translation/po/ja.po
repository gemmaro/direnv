#: ../man/direnv-stdlib.1.md:167
#, no-wrap
msgid "`path_add <varname> <path>`"
msgstr "`path_add <変数名> <パス>`"

#. type: paragraph
#: ../man/direnv-stdlib.1.md:169
#, no-wrap
msgid "Works like `PATH_add` except that it's for an arbitrary *varname*."
msgstr "`PATH_add`のような動作ですが、任意の*変数名*を対象とします。"

#. type: heading3
#: ../man/direnv-stdlib.1.md:171
#, no-wrap
msgid "`PATH_rm <pattern> [<pattern> ...]`"
msgstr "`PATH_rm <パターン> [<パターン> ...]`"

#. type: paragraph
#: ../man/direnv-stdlib.1.md:173
#, no-wrap
msgid "Removes directories that match any of the given shell patterns from the PATH environment variable. Order of the remaining directories is preserved in the resulting PATH."
msgstr ""
"与えられたシェルパターンに合致するディレクトリを、PATH環境変数から除きます。\n"
"残りのディレクトリの順序ば、結果のPATHで維持されます。"

#. type: paragraph
#: ../man/direnv-stdlib.1.md:175
#, fuzzy, no-wrap
#| msgid ""
#| "Bash pattern syntax:\n"
#| "  https://www.gnu.org/software/bash/manual/html_node/Pattern-Matching.html\n"
msgid "Bash pattern syntax: https://www.gnu.org/software/bash/manual/html\\_node/Pattern-Matching.html"
msgstr ""
"Bashのパターン構文：\n"
"  https://www.gnu.org/software/bash/manual/html_node/Pattern-Matching.html\n"

#. type: code_block
#: ../man/direnv-stdlib.1.md:180
#, fuzzy, no-wrap
#| msgid ""
#| "    echo $PATH\n"
#| "    # output: /dontremove/me:/remove/me:/usr/local/bin/:...\n"
#| "    PATH_rm '/remove/*'\n"
#| "    echo $PATH\n"
#| "    # output: /dontremove/me:/usr/local/bin/:...\n"
msgid ""
"echo $PATH\n"
"# output: /dontremove/me:/remove/me:/usr/local/bin/:...\n"
"PATH_rm '/remove/*'\n"
"echo $PATH\n"
"# output: /dontremove/me:/usr/local/bin/:..."
msgstr ""
"    echo $PATH\n"
"    # 出力：/dontremove/me:/remove/me:/usr/local/bin/:...\n"
"    PATH_rm '/remove/*'\n"
"    echo $PATH\n"
"    # 出力：/dontremove/me:/usr/local/bin/:...\n"

#. type: heading3
#: ../man/direnv-stdlib.1.md:187
#, no-wrap
msgid "`load_prefix <prefix_path>`"
msgstr "`load_prefix <接頭辞パス>`"

#. type: paragraph
#: ../man/direnv-stdlib.1.md:189
#, fuzzy, no-wrap
#| msgid "Expands some common path variables for the given *prefix_path* prefix. This is useful if you installed something in the *prefix_path* using `./configure --prefix=$prefix_path && make install` and want to use it in the project."
msgid "Expands some common path variables for the given *prefix\\_path* prefix. This is useful if you installed something in the *prefix\\_path* using `./configure --prefix=$prefix_path && make install` and want to use it in the project."
msgstr ""
"与えられた*接頭辞パス*について、よくあるパス変数を展開します。\n"
"`./configure --prefix=$prefix_path && make install`を使って*接頭辞パス*に何かをインストールしており、プロジェクトで使いたいときに便利です。"

#. type: paragraph
#: ../man/direnv-stdlib.1.md:191
#, no-wrap
msgid "Variables set:"
