#. type: code_block
#: ../man/direnv-stdlib.1.md:193
#, fuzzy, no-wrap
#| msgid ""
#| "    CPATH\n"
#| "    LD_LIBRARY_PATH\n"
#| "    LIBRARY_PATH\n"
#| "    MANPATH\n"
#| "    PATH\n"
#| "    PKG_CONFIG_PATH\n"
msgid ""
"CPATH\n"
"LD_LIBRARY_PATH\n"
"LIBRARY_PATH\n"
"MANPATH\n"
"PATH\n"
"PKG_CONFIG_PATH"
msgstr ""
"    CPATH\n"
"    LD_LIBRARY_PATH\n"
"    LIBRARY_PATH\n"
"    MANPATH\n"
"    PATH\n"
"    PKG_CONFIG_PATH\n"

#. type: code_block
#: ../man/direnv-stdlib.1.md:202
#, fuzzy, no-wrap
#| msgid ""
#| "    ./configure --prefix=$HOME/rubies/ruby-1.9.3\n"
#| "    make && make install\n"
#| "    # Then in the .envrc\n"
#| "    load_prefix ~/rubies/ruby-1.9.3\n"
msgid ""
"./configure --prefix=$HOME/rubies/ruby-1.9.3\n"
"make && make install\n"
"# Then in the .envrc\n"
"load_prefix ~/rubies/ruby-1.9.3"
msgstr ""
"    ./configure --prefix=$HOME/rubies/ruby-1.9.3\n"
"    make && make install\n"
"    # そして.envrcで次のようにします\n"
