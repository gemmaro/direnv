#. type: Title =
#: ../man/direnv-stdlib.1.md:2
#, no-wrap
msgid "DIRENV-STDLIB 1 \"2019\" direnv \"User Manuals\""
msgstr "DIRENV-STDLIB 1 \"2019\" direnv 「利用者用マニュアル」"

#. type: Plain text
#: ../man/direnv-stdlib.1.md:8
msgid "direnv-stdlib - functions for the `.envrc`"
